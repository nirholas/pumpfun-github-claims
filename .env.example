# Use a dedicated Telegram bot and an explicit channel you operate.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
CHANNEL_ID=replace-with-numeric-channel-id

# Pins the GitHub claims path and disables unrelated feed types.
# Historical name retained; see docs/implementation-status.md for current gaps.
FEED_PROFILE=github-first-claims
FEED_CREATOR_CLAIMS=false
FEED_LAUNCHES=false
FEED_GRADUATIONS=false
FEED_WHALES=false
FEED_FEE_DISTRIBUTIONS=false
PERFORMANCE_UPDATES=false

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
# SOLANA_RPC_URLS=https://your-primary-rpc,https://your-secondary-rpc
# SOLANA_WS_URLS=wss://your-primary-rpc,wss://your-secondary-rpc

# Optional enrichment; blank values are valid.
GITHUB_TOKEN=
GROQ_API_KEY=
# X_AUTH_TOKEN=
# X_CT0_TOKEN=

# Send-only by default. Configure admin IDs only for a bot you operate.
ADMIN_USER_IDS=
# ALERT_CHAT_ID=
# WEBHOOK_URLS=
# WEBHOOK_SECRET=
DATA_DIR=./data
PORT=3000
LOG_LEVEL=info
POLL_INTERVAL_SECONDS=30
