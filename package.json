{
  "name": "@nirholas/pumpfun-github-claims",
  "version": "0.1.0",
  "description": "Pump.fun GitHub Claims \u2014 read-only Telegram intelligence for first reward claims on GitHub-linked coins",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:endpoints": "node scripts/probe-endpoints.mjs --env .env",
    "doctor": "node scripts/doctor.mjs --env .env",
    "audit:claims": "node scripts/audit-first-claims.mjs --env .env",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "grammy": "^1.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "private": true,
  "license": "UNLICENSED",
  "author": "nirholas",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/pumpfun-github-claims.git"
  },
  "homepage": "https://t.me/pumpfunclaims",
  "bugs": {
    "url": "https://github.com/nirholas/pumpfun-github-claims/issues"
  }
}
